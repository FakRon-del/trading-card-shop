generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model Card {
  id          String   @id @default(cuid())
  name        String
  set         String
  number      String
  rarity      String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skus        CardSku[]
}

model CardSku {
  id        String    @id @default(cuid())
  card      Card      @relation(fields: [cardId], references: [id])
  cardId    String
  condition Condition
  price     Decimal   @db.Decimal(10, 2)
  stock     Int       @default(0)
  version   Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orderItems OrderItem[]
}

enum Condition {
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  DAMAGED
}

model Order {
  id         String      @id @default(cuid())
  user       User        @relation(fields: [userId], references: [id])
  userId     String
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(10, 2)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  DISPUTED
  REFUNDED
  CANCELLED
}

model OrderItem {
  id       String  @id @default(cuid())
  order    Order   @relation(fields: [orderId], references: [id])
  orderId  String
  sku      CardSku @relation(fields: [skuId], references: [id])
  skuId    String
  quantity Int
  price    Decimal @db.Decimal(10, 2)
}