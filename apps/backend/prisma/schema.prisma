generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  seller    Seller?
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model Seller {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @unique
  shopName    String    @unique
  description String?
  avatar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  listings    Listing[]
}

model Card {
  id        String      @id @default(cuid())
  name      String
  set       String
  number    String
  rarity    String
  category  Category    @default(SINGLE_CARD)
  imageUrl  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  listings  Listing[]
}

enum Category {
  SINGLE_CARD
  BOOSTER_BOX
  SLEEVES
  TOPLOADER
  ACRYLIC_CASE
  FRAME
}

model Listing {
  id         String      @id @default(cuid())
  card       Card        @relation(fields: [cardId], references: [id])
  cardId     String
  seller     Seller      @relation(fields: [sellerId], references: [id])
  sellerId   String
  condition  Condition
  price      Decimal     @db.Decimal(10, 2)
  stock      Int         @default(0)
  version    Int         @default(0)
  description String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

enum Condition {
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  DAMAGED
}

model Order {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  status        OrderStatus @default(PENDING)
  total         Decimal     @db.Decimal(10, 2)
  address       String?
  contactNumber String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  DISPUTED
  REFUNDED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
}